# Local API; keep it bound to loopback.
SAIA_HOST=127.0.0.1
SAIA_PORT=41732

# Ollama must be installed and running locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
SAIA_MODEL_FAST=qwen3.5:0.8b
SAIA_MODEL_REASONING=qwen3.5:4b
SAIA_MODEL_VISION=qwen3.5:4b

# 0 unloads the selected model after each request to reduce RAM use.
# Try 30s only if you have enough memory and want faster repeated calls.
OLLAMA_KEEP_ALIVE=0

# Optional. Leave empty for no web search and no API cost.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic